<div id="dongchat" class="dongchat-{$dongchat_position|escape:'html':'UTF-8'}" style="{if $dongchat_position == 'left'}left:20px;right:auto;{else}right:20px;left:auto;{/if}" data-endpoint="{$dongchat_endpoint|escape:'html':'UTF-8'}" data-popup="{$dongchat_popup|intval}"><button id="dongchat-toggle" type="button" aria-label="Open live chat">Chat <span id="dongchat-badge" hidden>●</span></button><section id="dongchat-panel" hidden aria-label="Dong Solar live chat"><header><div class="dc-agent"><span id="dongchat-agent-avatar" class="dc-agent-avatar" aria-hidden="true">DS</span><span class="dc-agent-copy"><strong id="dongchat-agent-name">Dong Solar Support</strong><small id="dongchat-agent-subtitle">Live chat support</small></span></div><div class="dc-header-actions"><button id="dongchat-maximize" type="button" aria-label="Maximize chat" title="Maximize chat" aria-pressed="false">&#9633;</button><button id="dongchat-minimize" type="button" aria-label="Minimize chat" title="Minimize chat">&#8722;</button><button id="dongchat-close" type="button" aria-label="Close chat">×</button></div></header><div id="dongchat-messages" aria-live="polite"></div><form id="dongchat-form"><input id="dongchat-input" maxlength="2000" placeholder="Write a message..." required aria-label="Message"><button type="submit">Send</button></form><small>{if $dongchat_ai}AI assistance may respond automatically. {/if}Chat messages are saved to help us respond to you.</small></section></div>
