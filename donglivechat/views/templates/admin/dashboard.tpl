<div id="dongchat-admin" data-url="{$dongchat_admin_url|escape:'html':'UTF-8'}" data-employee="{$dongchat_employee_id|intval}" data-open-tab="{$dongchat_open_tab|escape:'html':'UTF-8'}" data-selected="{if $dongchat_selected_visitor}{$dongchat_selected_visitor.id_visitor|intval}{else}0{/if}">
<h2>Dong Solar Live Chat</h2><nav class="dc-tabs" aria-label="Chat dashboard sections" role="tablist"><button type="button" data-dc-tab="live" aria-selected="true" class="dc-tab-active">Live Chat</button><button type="button" data-dc-tab="analytics" aria-selected="false">Visitor Analytics</button><button type="button" data-dc-tab="settings" aria-selected="false">Settings &amp; Data Retention</button><button type="button" data-dc-tab="leads" aria-selected="false">Customer Leads</button><a class="dc-tab-link" href="{$dongchat_admin_url|escape:'html':'UTF-8'}&amp;dc_tab=visits" data-dc-tab="visits" aria-selected="false">Visit History</a></nav><div class="dc-dashboard-sections"><div class="dc-alert-toolbar"><button type="button" id="dc-alert-badge" hidden aria-label="Open unread visitor messages"></button><label><input type="checkbox" id="dc-sound-messages"> Sound on visitor messages</label><label><input type="checkbox" id="dc-sound-arrivals"> Sound on new visitor arrival</label><label><input type="checkbox" id="dc-desktop-alerts"> Desktop alerts</label><button type="button" class="btn btn-default" id="dc-activate-sound">Enable / test sound</button><small id="dc-sound-status" role="status"></small><small> Keep this back-office page open for alerts.</small><p>Recent visitors. Select a visitor to view details and reply. Online means active within the last 60 seconds.</p>
